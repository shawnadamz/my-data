        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "sns.set_theme(style=\"whitegrid\", palette=\"deep\")\n",
        "\n",
        "\n",
        "# LOAD\n",
        "\n",
        "try:\n",
        "    df = sns.load_dataset(\"titanic\")\n",
        "except Exception:\n",
        "    df = pd.read_csv(\"titanic.csv\")\n",
        "    df.columns = [c.lower() for c in df.columns]\n",
        "\n",
        "print(\"Raw shape:\", df.shape)\n",
        "print(\"Missing values before cleaning:\\n\", df.isna().sum(), \"\\n\")\n",
        "\n",
        "\n",
        "# 2 CLEAN\n",
        "\n",
        "df = df.drop_duplicates()\n",
        "\n",
        "# age: fill with median of the same sex + class (smarter than one global median)\n",
        "df[\"age\"] = df[\"age\"].fillna(df.groupby([\"sex\", \"pclass\"])[\"age\"].transform(\"median\"))\n",
        "\n",
        "# embarked: fill with most common port\n",
        "df[\"embarked\"] = df[\"embarked\"].fillna(df[\"embarked\"].mode()[0])\n",
        "\n",
        "# deck: ~77% missing, drop it\n",
        "df = df.drop(columns=[\"deck\"], errors=\"ignore\")\n",
        "\n",
        "# new features\n",
        "df[\"family_size\"] = df[\"sibsp\"] + df[\"parch\"] + 1\n",
        "df[\"age_group\"] = pd.cut(\n",
        "    df[\"age\"],\n",
        "    bins=[0, 12, 18, 30, 45, 60, 100],\n",
        "    labels=[\"0-12\", \"13-18\", \"19-30\", \"31-45\", \"46-60\", \"60+\"],\n",
        ")\n",
        "\n",
        "print(\"Missing values after cleaning:\\n\", df.isna().sum(), \"\\n\")\n",
        "\n",
        "\n",
        "# 3 DASHBOARD (2 rows x 3 columns)\n",
        "\n",
        "fig, axes = plt.subplots(2, 3, figsize=(20, 11))\n",
        "fig.suptitle(\"Titanic Survival Dashboard\", fontsize=22, fontweight=\"bold\")\n",
        "\n",
        "# img 1  HISTOGRAM: age distribution by survival\n",
        "sns.histplot(data=df, x=\"age\", hue=\"survived\", bins=25, kde=True,\n",
        "             multiple=\"layer\", ax=axes[0, 0])\n",
        "axes[0, 0].set_title(\"1) Age distribution: survived vs not\")\n",
        "axes[0, 0].set_xlabel(\"Age\")\n",
        "\n",
        "# img 2  BAR: survival rate by class and sex\n",
        "sns.barplot(data=df, x=\"pclass\", y=\"survived\", hue=\"sex\",\n",
        "            errorbar=None, ax=axes[0, 1])\n",
        "axes[0, 1].set_title(\"2) Survival rate by class and sex\")\n",
        "axes[0, 1].set_xlabel(\"Passenger class\")\n",
        "axes[0, 1].set_ylabel(\"Survival rate\")\n",
        "\n",
        "# img 3  LINE: survival rate across age groups, split by sex\n",
        "rate = (df.groupby([\"age_group\", \"sex\"], observed=True)[\"survived\"]\n",
        "          .mean().reset_index())\n",
        "sns.lineplot(data=rate, x=\"age_group\", y=\"survived\", hue=\"sex\",\n",
        "             marker=\"o\", ax=axes[0, 2])\n",
        "axes[0, 2].set_title(\"3) Survival rate by age group\")\n",
        "axes[0, 2].set_xlabel(\"Age group\")\n",
        "axes[0, 2].set_ylabel(\"Survival rate\")\n",
        "\n",
        "# img 4  SCATTER: age vs fare, colored by survival\n",
        "sns.scatterplot(data=df, x=\"age\", y=\"fare\", hue=\"survived\",\n",
        "                alpha=0.6, ax=axes[1, 0])\n",
        "axes[1, 0].set_yscale(\"log\")\n",
        "axes[1, 0].set_title(\"4) Age vs fare (log scale)\")\n",
        "axes[1, 0].set_xlabel(\"Age\")\n",
        "axes[1, 0].set_ylabel(\"Fare (log)\")\n",
        "\n",
        "# img 5  BAR: survival rate by family size\n",
        "sns.barplot(data=df, x=\"family_size\", y=\"survived\", errorbar=None,\n",
        "            color=\"steelblue\", ax=axes[1, 1])\n",
        "axes[1, 1].set_title(\"5) Survival rate by family size\")\n",
        "axes[1, 1].set_xlabel(\"Family size (incl. self)\")\n",
        "axes[1, 1].set_ylabel(\"Survival rate\")\n",
        "\n",
        "# 6  HEATMAP: correlation of numeric columns\n",
        "num = df[[\"survived\", \"pclass\", \"age\", \"sibsp\", \"parch\", \"fare\", \"family_size\"]]\n",
        "sns.heatmap(num.corr(), annot=True, fmt=\".2f\", cmap=\"coolwarm\",\n",
        "            center=0, ax=axes[1, 2])\n",
        "axes[1, 2].set_title(\"6) Correlation heatmap\")\n",
        "\n",
        "plt.tight_layout(rect=[0, 0, 1, 0.96])\n",
        "plt.savefig(\"dashboard.png\", dpi=150)\n",
        "plt.show()\n",
        "\n",
        "# Summary\n",
        "\n",
        "print(\"Overall survival rate:\", round(df[\"survived\"].mean(), 3))\n",
        "print(\"\\nSurvival by sex:\\n\", df.groupby(\"sex\")[\"survived\"].mean().round(3))\n",
        "print(\"\\nSurvival by class:\\n\", df.groupby(\"pclass\")[\"survived\"].mean().round(3))\n",
        "print(\"\\nSurvival by age group:\\n\",\n",
        "      df.groupby(\"age_group\", observed=True)[\"survived\"].mean().round(3))\n"
      ]
